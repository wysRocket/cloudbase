# Supabase Edge Function secrets — copy to .env and fill in real values.
# For production, set these via: supabase secrets set KEY=VALUE
# or in the Supabase Dashboard → Project Settings → Edge Functions → Secrets.

# ── DigitalOcean ────────────────────────────────────────────────────────────
DIGITALOCEAN_API_TOKEN=

# ── SafePay payment gateway ──────────────────────────────────────────────────
SAFEPAY_MERCHANT_KEY=
SAFEPAY_MERCHANT_SECRET=
SAFEPAY_ENV=production    # or: sandbox

# ── SMTP (Hostinger) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@cloudbaseservice.com
SMTP_PASSWORD=

# ── Internal worker auth ─────────────────────────────────────────────────────
PROVISION_WORKER_SECRET=
